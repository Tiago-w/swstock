<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="750.0" prefWidth="1180.0"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.GlobalStockHistoryController">

    <children>
        <!-- Topo: Banner Vibrante -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-banner">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="SWStock" />
                        <Label text="📅 Calendário &amp; Histórico Global de Estoque com Filtro por Fabricante"
                               style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleExportarPdf"
                        style="-fx-background-color: #0D47A1; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-font-size: 12px;"
                        text="📄 Exportar Relatório PDF" />
                <Button onAction="#handleFechar" styleClass="btn-secondary" text="Fechar" />
            </children>
        </HBox>

        <!-- Conteúdo Principal -->
        <VBox spacing="14.0" VBox.vgrow="ALWAYS" style="-fx-padding: 18px 24px;">
            <children>

                <!-- Barra de Filtros e Calendário -->
                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 14px 18px;">
                    <children>
                        <!-- Linha 1: Calendário e Datas -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Período:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                
                                <Label text="De:" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                                <DatePicker fx:id="dpDataInicio" promptText="Data inicial" prefWidth="135.0" styleClass="search-field" />
                                
                                <Label text="Até:" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                                <DatePicker fx:id="dpDataFim" promptText="Data final" prefWidth="135.0" styleClass="search-field" />

                                <Button onAction="#handleFiltrar" text="Filtrar" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-padding: 6px 14px;" />

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;" />

                                <!-- Atalhos de Calendário -->
                                <Button onAction="#handleAtalhoHoje" text="Hoje" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoUltimos7Dias" text="Últimos 7 Dias" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoEsteMes" text="Este Mês" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoTodos" text="Todo o Período"
                                        style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Separator style="-fx-opacity: 0.2;" />

                        <!-- Linha 2: Tipo de Operação, Fabricante / Grupo e Busca Textual -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Operação:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <ComboBox fx:id="cbTipoOperacao" prefWidth="200.0" styleClass="search-field" />

                                <Label text="Fabricante / Grupo:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <ComboBox fx:id="cbGrupoFabricante" prefWidth="210.0" styleClass="search-field" />

                                <Label text="Buscar:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <TextField fx:id="txtBuscaGlobal" promptText="Buscar por produto, código, grupo ou motivo..."
                                           styleClass="search-field" prefWidth="240.0" HBox.hgrow="ALWAYS" />

                                <Button onAction="#handleLimparFiltros" text="Limpar Filtros" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 12px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Cards de Métricas e Totais Consolidados -->
                <HBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="TOTAL DE ENTRADAS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #15803D;" />
                                        <Label fx:id="lblTotalEntradasGlobal" text="+0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-red" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="TOTAL DE SAÍDAS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;" />
                                        <Label fx:id="lblTotalSaidasGlobal" text="-0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #991B1B;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-blue" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="BALANÇO LÍQUIDO DO PERÍODO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;" />
                                        <Label fx:id="lblBalancoGlobal" text="0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 14px;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="REGISTROS ENCONTRADOS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                        <Label fx:id="lblTotalRegistrosGlobal" text="0 movimentos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Tabela de Movimentações Globais de Todos os Produtos com Coluna de Fabricante / Grupo -->
                <TableView fx:id="tblHistoricoGlobal" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colDataHora" text="Data e Hora (Dia/Mês/Ano)" prefWidth="145.0" />
                        <TableColumn fx:id="colCodigo" text="Código (SKU)" prefWidth="95.0" />
                        <TableColumn fx:id="colProduto" text="Nome do Produto" prefWidth="200.0" />
                        <TableColumn fx:id="colGrupo" text="Fabricante / Grupo" prefWidth="130.0" />
                        <TableColumn fx:id="colLocalizacao" text="Estante / Local" prefWidth="110.0" />
                        <TableColumn fx:id="colTipo" text="Operação" prefWidth="95.0" />
                        <TableColumn fx:id="colQtd" text="Movimento" prefWidth="90.0" />
                        <TableColumn fx:id="colSaldo" text="Saldo (De -> Para)" prefWidth="115.0" />
                        <TableColumn fx:id="colResponsavel" text="Responsável" prefWidth="110.0" />
                        <TableColumn fx:id="colMotivo" text="Motivo / Origem" prefWidth="150.0" />
                        <TableColumn fx:id="colAcoes" text="Ações" prefWidth="85.0" style="-fx-alignment: CENTER;" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Nenhuma movimentação de estoque encontrada para os filtros selecionados."
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 13px; -fx-padding: 30px;" />
                    </placeholder>
                </TableView>

                <!-- Rodapé informativo -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label fx:id="lblStatusFiltro" text="Exibindo todas as movimentações registradas no sistema."
                               style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRecarregar" text="Atualizar Extrato" styleClass="btn-secondary" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
