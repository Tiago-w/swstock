<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<HBox fx:id="rootPane" prefWidth="760.0" prefHeight="450.0"
      stylesheets="@../css/styles.css" styleClass="login-root"
      xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.LoginController">

    <!-- Painel Esquerdo: Banner SWStock (mesma identidade visual do app principal) -->
    <VBox prefWidth="300.0" minWidth="300.0" maxWidth="300.0" spacing="16.0" styleClass="login-brand-panel">
        <padding>
            <Insets top="44.0" right="30.0" bottom="26.0" left="32.0" />
        </padding>

        <VBox spacing="12.0">
            <Label text="SWStock" styleClass="login-brand-title" />
            <Region prefWidth="42.0" maxWidth="42.0" prefHeight="3.5" styleClass="login-brand-accent" />
            <Label text="Gestão inteligente de estoque, movimentações e relatórios com total controle e precisão."
                   wrapText="true" minHeight="-Infinity" styleClass="login-brand-desc" />
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <VBox spacing="10.0">
            <Region prefHeight="1.0" maxWidth="Infinity" styleClass="login-brand-divider" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Group>
                    <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                             fill="#0D47A1" scaleX="0.62" scaleY="0.62" />
                </Group>
                <Label text="Base SQLite local • 100% Offline" styleClass="login-brand-meta" />
            </HBox>
            <Label text="Versão 1.0.13" styleClass="login-brand-version" />
        </VBox>
    </VBox>

    <!-- Painel Direito: Logo da Empresa & Seleção do Operador -->
    <VBox HBox.hgrow="ALWAYS" spacing="22.0" styleClass="login-form-panel">
        <padding>
            <Insets top="36.0" right="44.0" bottom="24.0" left="44.0" />
        </padding>

        <!-- Logo da Empresa no Topo -->
        <HBox alignment="CENTER">
            <ImageView fx:id="imgLogo" fitHeight="68.0" fitWidth="240.0" preserveRatio="true" smooth="true" />
        </HBox>

        <!-- Cabeçalho de Boas-vindas -->
        <VBox spacing="6.0">
            <Label text="Acesso ao Sistema" styleClass="login-heading" />
            <Label text="Selecione o operador responsável pelas movimentações e registros desta sessão."
                   wrapText="true" minHeight="-Infinity" styleClass="login-subtitle" />
        </VBox>

        <!-- Seletor de Operador -->
        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <Group>
                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                             fill="#64748B" scaleX="0.58" scaleY="0.58" />
                </Group>
                <Label text="OPERADOR RESPONSÁVEL" styleClass="login-field-label" />
            </HBox>
            <ComboBox fx:id="cmbOperadores" maxWidth="Infinity" styleClass="login-combobox"
                      promptText="Selecione o operador..." />
        </VBox>

        <!-- Ação Principal -->
        <Button fx:id="btnAcessar" text="Entrar no Sistema" maxWidth="Infinity"
                defaultButton="true" onAction="#handleAcessarSistema"
                contentDisplay="RIGHT" graphicTextGap="10.0"
                styleClass="login-btn-primary">
            <graphic>
                <Group>
                    <SVGPath content="M4 11h12.17l-5.59-5.59L12 4l8 8-8 8-1.41-1.41L16.17 13H4v-2z"
                             fill="#FFFFFF" scaleX="0.72" scaleY="0.72" />
                </Group>
            </graphic>
        </Button>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Rodapé Discreto -->
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnSair" text="Sair" onAction="#handleSair"
                    graphicTextGap="6.0" styleClass="login-btn-exit">
                <graphic>
                    <Group>
                        <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                                 fill="#64748B" scaleX="0.60" scaleY="0.60" />
                    </Group>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</HBox>
