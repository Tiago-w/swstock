<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="760.0" prefWidth="1200.0"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.ConfiguracoesController">

    <!-- Topo: Banner Superior -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-banner">
        <children>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <children>
                    <Label styleClass="brand-title" text="SWStock" />
                    <Label text="Configurações &amp; Gestão Financeira de Estoque"
                           style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleFechar" styleClass="btn-secondary" text="Fechar" />
        </children>
    </HBox>

    <!-- Conteúdo em Abas -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <!-- Aba 1: Valor de Estoque -->
            <Tab text="Valor de Estoque">
                <VBox spacing="14.0" style="-fx-padding: 18px 24px;">
                    <children>
                        <!-- Barra de Filtros -->
                        <VBox spacing="10.0" styleClass="filter-container">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label text="Fabricante / Grupo:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                        <ComboBox fx:id="cbGrupo" prefWidth="250.0" styleClass="search-field" />

                                        <Button fx:id="btnGeral" onAction="#handleSelecionarGeral"
                                                text="Geral (Todos os Grupos)"
                                                style="-fx-background-color: #1E293B; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" />

                                        <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;" />

                                        <CheckBox fx:id="chkApenasComEstoque" text="Apenas produtos com estoque (> 0)"
                                                  selected="true"
                                                  style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155; -fx-cursor: hand;" />

                                        <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;" />

                                        <Label text="Buscar:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                        <TextField fx:id="txtBusca" promptText="Buscar por código, produto ou grupo..."
                                                   styleClass="search-field" prefWidth="240.0" HBox.hgrow="ALWAYS" />

                                        <Button onAction="#handleLimparFiltros" text="Limpar" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 14px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Cards de Métricas Financeiras -->
                        <HBox spacing="14.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label text="VALOR TOTAL DO ESTOQUE (À VISTA)" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #15803D;" />
                                                <Label fx:id="lblValorTotalVista" text="R$ 0,00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-blue" HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label text="VALOR TOTAL DO ESTOQUE (A PRAZO)" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;" />
                                                <Label fx:id="lblValorTotalPrazo" text="R$ 0,00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 14px;"
                                      HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label text="TOTAL DE ITENS LISTADOS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                <Label fx:id="lblTotalItens" text="0 produtos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 14px;"
                                      HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label text="TOTAL DE UNIDADES EM ESTOQUE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                <Label fx:id="lblTotalUnidades" text="0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Tabela Detalhada com Subtotais -->
                        <TableView fx:id="tblValorEstoque" VBox.vgrow="ALWAYS" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colCodigo" text="Cód. Loja" prefWidth="95.0" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colNome" text="Nome do Produto" prefWidth="260.0" />
                                <TableColumn fx:id="colGrupo" text="Fabricante / Grupo" prefWidth="130.0" />
                                <TableColumn fx:id="colCor" text="Cor" prefWidth="110.0" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colEstoque" text="Estoque" prefWidth="85.0" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colPrecoVista" text="Unit. à Vista" prefWidth="105.0" style="-fx-alignment: CENTER_RIGHT;" />
                                <TableColumn fx:id="colSubtotalVista" text="Subtotal à Vista" prefWidth="125.0" style="-fx-alignment: CENTER_RIGHT;" />
                                <TableColumn fx:id="colPrecoPrazo" text="Unit. a Prazo" prefWidth="105.0" style="-fx-alignment: CENTER_RIGHT;" />
                                <TableColumn fx:id="colSubtotalPrazo" text="Subtotal a Prazo" prefWidth="125.0" style="-fx-alignment: CENTER_RIGHT;" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Nenhum produto correspondente aos filtros de valor de estoque selecionados."
                                       style="-fx-text-fill: #94A3B8; -fx-font-size: 13px; -fx-padding: 30px;" />
                            </placeholder>
                        </TableView>

                        <!-- Rodapé com Status e Ações -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label fx:id="lblStatusFiltro" text="Exibindo: Todos os grupos"
                                       style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS" />

                                <Button onAction="#handleExportarPdf" text="Exportar Extrato PDF (Valor de Estoque)"
                                        styleClass="btn-primary" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8px 18px;" />

                                <Button onAction="#handleFechar" text="Fechar"
                                        styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 8px 16px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </Tab>

            <!-- Aba 2: Informações do Sistema -->
            <Tab text="Sobre o Sistema">
                <VBox spacing="16.0" style="-fx-padding: 24px;">
                    <children>
                        <Label text="SWStock - Sistema de Controle e Gestão de Estoque"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                        <Label text="Versão: 1.0.1 (Offline-First com banco SQLite local)"
                               style="-fx-font-size: 13px; -fx-text-fill: #475569;" />
                        <Separator style="-fx-opacity: 0.3;" />
                        <Label text="Módulos Integrados:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1E293B;" />
                        <Label text="• Catálogo Geral de Produtos com Múltiplas Cores e Códigos de Loja" style="-fx-text-fill: #334155;" />
                        <Label text="• Módulo Especializado de Tintas (Bases Automotivas &amp; Prediais com Fabricantes)" style="-fx-text-fill: #334155;" />
                        <Label text="• Histórico de Movimentações Isolado com Relatórios PDF Executivos" style="-fx-text-fill: #334155;" />
                        <Label text="• Levantamento Físico de Estoque &amp; Ficha de Pedido (Sem valores financeiros para confidencialidade)" style="-fx-text-fill: #334155;" />
                        <Label text="• Painel de Avaliação Financeira de Estoque (Valores Totais à Vista e a Prazo por Fabricante ou Geral)" style="-fx-text-fill: #334155;" />
                        <Label text="• Exportação e Importação Completa em XML com Proteção Absoluta de Estoque" style="-fx-text-fill: #334155;" />
                        <Label text="• Busca Inteligente de Fotos e Descrições Comerciais na Internet" style="-fx-text-fill: #334155;" />
                    </children>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
