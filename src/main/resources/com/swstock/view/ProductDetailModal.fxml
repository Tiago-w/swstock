<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="800.0" prefWidth="1080.0"
      minWidth="920.0" minHeight="680.0"
      stylesheets="@../css/styles.css"
      styleClass="product-modal-root"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.ProductDetailController">

    <children>
        <!-- Cabeçalho Executivo SWStock (mesmo padrão da Tela de Login, Responsáveis e Bases) -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="product-modal-header">
            <children>
                <StackPane styleClass="switch-operator-icon-badge">
                    <Group>
                        <SVGPath content="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"
                                 fill="#FFFFFF" scaleX="0.88" scaleY="0.88" />
                    </Group>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblModalNome" styleClass="switch-operator-title" text="Nome do Produto" />
                        <Label fx:id="lblModalCodigo" styleClass="switch-operator-subtitle" text="CÓDIGO: #000000" />
                    </children>
                </VBox>

                <Label fx:id="lblAutoSaveStatus" text="Sincronizado com SQLite" styleClass="product-status-pill-ok" />
            </children>
        </HBox>

        <!-- Barra de Carregamento Web -->
        <HBox fx:id="boxLoadingWeb" alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;"
              visible="false" managed="false">
            <VBox.margin>
                <Insets top="10.0" right="24.0" bottom="0.0" left="24.0" />
            </VBox.margin>
            <children>
                <ProgressIndicator prefHeight="20.0" prefWidth="20.0" />
                <Label fx:id="lblLoadingWebText" text="Buscando foto real e descrição do produto na internet..."
                       style="-fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-font-size: 12px;" />
            </children>
        </HBox>

        <!-- TabPane Principal -->
        <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="product-tab-pane">
            <tabs>
                <!-- ABA 1: Dados do Produto e Edição Rápida -->
                <Tab text="Dados Gerais &amp; Estoque">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC;">
                            <content>
                                <VBox spacing="16.0" style="-fx-padding: 18px 24px 22px 24px; -fx-background-color: #F8FAFC;">
                                    <children>
                                        <!-- Card 1: Controle de Estoque & Variações -->
                                        <VBox spacing="12.0" styleClass="product-section-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Group>
                                                            <SVGPath content="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"
                                                                     fill="#1565C0" scaleX="0.62" scaleY="0.62" />
                                                        </Group>
                                                        <Label text="CONTROLE DE ESTOQUE &amp; VARIAÇÕES" styleClass="login-field-label" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="lblDeltaEstoque" text="" visible="false" managed="false" />
                                                        <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="product-initial-stock-pill">
                                                            <children>
                                                                <Label text="AO ABRIR:" style="-fx-font-size: 10px; -fx-text-fill: #64748B; -fx-font-weight: bold;" />
                                                                <Label fx:id="lblEstoqueInicial" text="0 un." style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                                    <children>
                                                        <!-- Stepper de Quantidade -->
                                                        <VBox alignment="CENTER" spacing="6.0" styleClass="product-subpanel" minWidth="230.0">
                                                            <children>
                                                                <HBox alignment="CENTER" spacing="10.0">
                                                                    <children>
                                                                        <Button fx:id="btnDecrement" onAction="#handleDecrement"
                                                                                styleClass="stepper-btn-minus" text="−" />
                                                                        <TextField fx:id="txtQuantidade" styleClass="modal-qty-field" text="0" />
                                                                        <Button fx:id="btnIncrement" onAction="#handleIncrement"
                                                                                styleClass="stepper-btn-plus" text="+" />
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="lblQuantidadeDesc" text="UNIDADES EM ESTOQUE" wrapText="true"
                                                                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748B; -fx-text-alignment: CENTER;" />
                                                            </children>
                                                        </VBox>

                                                        <!-- Subpainel de Cores -->
                                                        <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="product-subpanel" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label text="COR ATUAL:" styleClass="login-field-label" />
                                                                        <ComboBox fx:id="cbCorAtual" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                                                  styleClass="modal-compact-combo" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Button fx:id="btnAdicionarCor" onAction="#handleAbrirAdicionarCor"
                                                                                styleClass="btn-mini-blue" text="+ Adicionar Cor" />
                                                                        <Button fx:id="btnVerCores" onAction="#handleAbrirGerenciarCores"
                                                                                styleClass="btn-mini-slate" text="Ver Cores" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <!-- Subpainel de Subcategorias -->
                                                        <VBox alignment="CENTER_LEFT" spacing="7.0" styleClass="product-subpanel" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <CheckBox fx:id="chkPossuiSubcategorias" text="Produto possui subcategorias"
                                                                          style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #6B21A8; -fx-cursor: hand;" />
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label text="SUBCAT.:" styleClass="login-field-label" />
                                                                        <ComboBox fx:id="cbSubcategoriaAtual" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                                                  styleClass="modal-compact-combo" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Button fx:id="btnAdicionarSubcategoria" onAction="#handleAbrirAdicionarSubcategoria"
                                                                                styleClass="btn-mini-purple" text="+ Subcategoria" />
                                                                        <Button fx:id="btnVerSubcategorias" onAction="#handleAbrirGerenciarSubcategorias"
                                                                                styleClass="btn-mini-slate" text="Ver Subcategorias" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Card 2: Dados Cadastrais e Valores -->
                                        <VBox spacing="14.0" styleClass="product-section-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Group>
                                                            <SVGPath content="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"
                                                                     fill="#1565C0" scaleX="0.60" scaleY="0.60" />
                                                        </Group>
                                                        <Label text="DADOS CADASTRAIS &amp; VALORES" styleClass="login-field-label" />
                                                    </children>
                                                </HBox>

                                                <GridPane hgap="16.0" vgap="12.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="50.0" />
                                                        <ColumnConstraints percentWidth="50.0" />
                                                    </columnConstraints>

                                                    <children>
                                                        <!-- Linha 0: Nome e Código Loja -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0" minHeight="24.0">
                                                                    <children>
                                                                        <Label styleClass="login-field-label" text="NOME DO PRODUTO *" />
                                                                        <Region HBox.hgrow="ALWAYS" />
                                                                        <Button fx:id="btnBuscarWebNome" onAction="#handleBuscarNaWeb"
                                                                                styleClass="btn-mini-blue" text="Buscar na Internet" />
                                                                    </children>
                                                                </HBox>
                                                                <TextField fx:id="txtNome" promptText="Ex: spray da marca etaniz, verniz automotivo..."
                                                                           styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" minHeight="24.0">
                                                                    <children>
                                                                        <Label styleClass="login-field-label" text="CÓDIGO DA LOJA (SKU) *" />
                                                                    </children>
                                                                </HBox>
                                                                <TextField fx:id="txtCodigoLoja" styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <!-- Linha 1: Grupo / Fabricante e Subcategoria -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label styleClass="login-field-label" text="GRUPO / FABRICANTE" />
                                                                <TextField fx:id="txtGrupo" promptText="Ex: Tintas, Ferramentas, Abrasivos, Diversos"
                                                                           styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label styleClass="login-field-label" text="SUBCATEGORIA / SUBFABRICANTE" />
                                                                <TextField fx:id="txtSubcategoria" promptText="Ex: 900ml, 3.6L, Linha Premium..."
                                                                           styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <!-- Linha 2: Localização no Depósito e Valor à Vista -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0" minHeight="24.0">
                                                                    <children>
                                                                        <Label styleClass="login-field-label" text="LOCALIZAÇÃO NO DEPÓSITO" />
                                                                        <Region HBox.hgrow="ALWAYS" />
                                                                        <Button fx:id="btnVerLocalMapa" onAction="#handleVerLocalMapa"
                                                                                styleClass="btn-mini-amber" text="Ver no Mapa" />
                                                                    </children>
                                                                </HBox>
                                                                <TextField fx:id="txtLocalizacao" promptText="Ex: Estante A1, Prateleira B3"
                                                                           styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" minHeight="24.0">
                                                                    <children>
                                                                        <Label styleClass="login-field-label" text="VALOR À VISTA (R$)" />
                                                                    </children>
                                                                </HBox>
                                                                <TextField fx:id="txtPrecoVista" styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <!-- Linha 3: Valor a Prazo e URL da Imagem -->
                                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                            <children>
                                                                <Label styleClass="login-field-label" text="VALOR A PRAZO (R$)" />
                                                                <TextField fx:id="txtPrecoPrazo" styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                            <children>
                                                                <Label styleClass="login-field-label" text="URL / CAMINHO DA IMAGEM" />
                                                                <TextField fx:id="txtUrlImagem" promptText="https://... ou file:///..."
                                                                           styleClass="modal-text-field" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>

                                        <!-- Card 3: Foto e Descrição do Produto -->
                                        <VBox spacing="12.0" styleClass="product-section-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Group>
                                                            <SVGPath content="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                                                     fill="#1565C0" scaleX="0.60" scaleY="0.60" />
                                                        </Group>
                                                        <Label text="IMAGEM &amp; DESCRIÇÃO COMERCIAL" styleClass="login-field-label" />
                                                    </children>
                                                </HBox>

                                                <HBox spacing="16.0">
                                                    <children>
                                                        <VBox alignment="CENTER" styleClass="ai-placeholder-card" prefWidth="230.0" minHeight="155.0" spacing="8.0">
                                                            <children>
                                                                <ImageView fx:id="imgProduto" fitHeight="105.0" fitWidth="170.0"
                                                                           pickOnBounds="true" preserveRatio="true" />
                                                                <Label fx:id="lblFotoPlaceholder" style="-fx-font-size: 11px; -fx-text-fill: #64748B; -fx-text-alignment: CENTER;"
                                                                       wrapText="true" text="Nenhuma foto carregada&#10;Clique em 'Buscar na Internet' acima" />

                                                                <HBox fx:id="boxImageNav" alignment="CENTER" spacing="8.0" visible="false" managed="false">
                                                                    <children>
                                                                        <Button onAction="#handleFotoAnterior" styleClass="btn-mini-slate" text="&lt;" />
                                                                        <Label fx:id="lblFotoCounter" style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="1 / 1" />
                                                                        <Button onAction="#handleFotoProxima" styleClass="btn-mini-slate" text="&gt;" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="login-field-label" text="DESCRIÇÃO DO PRODUTO" />
                                                                <TextArea fx:id="txtDescricaoBreve" prefRowCount="5"
                                                                          promptText="Descrição detalhada e comercial do produto..."
                                                                          wrapText="true" styleClass="modal-text-area" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ABA 2: Histórico de Movimentações & Calendário -->
                <Tab text="Histórico de Movimentações &amp; Calendário">
                    <content>
                        <VBox spacing="14.0" style="-fx-padding: 18px 24px 20px 24px; -fx-background-color: #F8FAFC;">
                            <children>
                                <!-- Barra Superior de Filtro por Calendário -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="product-section-card">
                                    <children>
                                        <Label text="Filtrar por Data:" styleClass="login-field-label" />
                                        <DatePicker fx:id="dpFiltroData" promptText="Selecione uma data..."
                                                    prefWidth="165.0" styleClass="modal-compact-combo" />
                                        <Button onAction="#handleFiltrarData" text="Filtrar" styleClass="btn-mini-blue" />
                                        <Button onAction="#handleFiltrarHoje" text="Hoje" styleClass="btn-mini-slate" />
                                        <Button onAction="#handleLimparFiltroData" text="Todos os Registros" styleClass="btn-mini-slate" />

                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblFiltroHistoricoStatus" text="Exibindo: Todos os Registros"
                                               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #64748B;" />
                                    </children>
                                </HBox>

                                <!-- Cards de Métricas -->
                                <HBox spacing="14.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="TOTAL ADICIONADO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #15803D;" />
                                                        <Label fx:id="lblTotalAdicionado" text="+0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-red" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="TOTAL SUBTRAÍDO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;" />
                                                        <Label fx:id="lblTotalSubtraido" text="-0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #991B1B;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-blue" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="SALDO ATUAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;" />
                                                        <Label fx:id="lblSaldoAtualHistorico" text="0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Tabela de Extrato de Movimentações -->
                                <TableView fx:id="tblHistorico" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colDataHora" id="colDataHora" text="Data e Hora (Dia/Mês/Ano)" prefWidth="150.0" />
                                        <TableColumn fx:id="colTipo" id="colTipo" text="Operação" prefWidth="90.0" />
                                        <TableColumn fx:id="colQtdAlterada" id="colQtdAlterada" text="Movimento" prefWidth="90.0" />
                                        <TableColumn fx:id="colSaldo" id="colSaldo" text="Saldo (De -> Para)" prefWidth="120.0" />
                                        <TableColumn fx:id="colResponsavel" id="colResponsavel" text="Responsável" prefWidth="120.0" />
                                        <TableColumn fx:id="colMotivo" id="colMotivo" text="Motivo / Origem" prefWidth="180.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="Nenhuma movimentação registrada para os critérios selecionados."
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <!-- Barra Inferior Fixa: Seletor Rápido de Quem Editou (1 clique) + Ações -->
        <VBox spacing="12.0" minHeight="-Infinity" styleClass="product-modal-bottom-bar">
            <children>
                <!-- Faixa de Seleção Rápida de Responsável (obrigatória para liberar Salvar) -->
                <HBox fx:id="boxQuickOperator" alignment="CENTER_LEFT" spacing="12.0" styleClass="quick-operator-strip-pending">
                    <children>
                        <VBox alignment="CENTER_LEFT" spacing="4.0" minWidth="230.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Group>
                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                                 fill="#475569" scaleX="0.62" scaleY="0.62" />
                                    </Group>
                                    <Label text="QUEM REALIZOU A ALTERAÇÃO? *" styleClass="login-field-label" />
                                </HBox>
                                <Label fx:id="lblStatusResponsavelEdicao" text="Selecione quem editou para liberar Salvar"
                                       styleClass="operator-lock-pill-pending" />
                            </children>
                        </VBox>

                        <FlowPane fx:id="flowOperadoresRapidos" hgap="8.0" vgap="6.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- Botões de Ação do Rodapé -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button fx:id="btnExcluirProduto" onAction="#handleExcluirProduto"
                                styleClass="btn-modal-danger" text="Excluir Produto" />
                        <Region HBox.hgrow="ALWAYS" />
