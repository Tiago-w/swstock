<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="820.0"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.ProductDetailController">

    <children>
        <!-- Cabeçalho do Produto -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              style="-fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 16px 24px; -fx-background-color: #FFFFFF;">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblModalNome" styleClass="modal-header-title" text="Nome do Produto" />
                        <Label fx:id="lblModalCodigo" styleClass="modal-header-code" text="CÓDIGO: #000000" />
                    </children>
                </VBox>
                <Label fx:id="lblAutoSaveStatus" text="Sincronizado com SQLite"
                       style="-fx-text-fill: #16A34A; -fx-font-weight: bold; -fx-font-size: 11px;" />
            </children>
        </HBox>

        <!-- Barra de Carregamento Web -->
        <HBox fx:id="boxLoadingWeb" alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-margin: 8px 24px;"
              visible="false" managed="false">
            <children>
                <ProgressIndicator prefHeight="22.0" prefWidth="22.0" />
                <Label fx:id="lblLoadingWebText" text="Buscando foto real e descrição do produto na internet..."
                       style="-fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-font-size: 12px;" />
            </children>
        </HBox>

        <!-- TabPane Principal -->
        <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: #F8FAFC;">
            <tabs>
                <!-- ABA 1: Dados do Produto e Edição Rápida -->
                <Tab text="Dados Gerais &amp; Estoque">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #FFFFFF; -fx-background: #FFFFFF;">
                            <content>
                                <VBox spacing="18.0" style="-fx-padding: 20px 24px;">
                                    <children>
                                        <!-- Seção 1: Ajuste de Inventário -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #0F172A;"
                                                       text="Controle de Estoque (Clique em 'Salvar Alterações' para confirmar a movimentação)" />
                                                <HBox alignment="CENTER" spacing="16.0" styleClass="stepper-container">
                                                    <children>
                                                        <Button fx:id="btnDecrement" onAction="#handleDecrement"
                                                                styleClass="stepper-btn" text="-" />

                                                        <VBox alignment="CENTER" spacing="4.0">
                                                            <children>
                                                                <TextField fx:id="txtQuantidade" styleClass="stepper-input" text="0" />
                                                                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="UNIDADES EM ESTOQUE" />
                                                            </children>
                                                        </VBox>

                                                        <Button fx:id="btnIncrement" onAction="#handleIncrement"
                                                                styleClass="stepper-btn" text="+" />

                                                        <VBox alignment="CENTER_LEFT" spacing="2.0"
                                                              style="-fx-padding: 4px 12px; -fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;">
                                                            <children>
                                                                <Label style="-fx-font-size: 9px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="ESTOQUE AO ABRIR:" />
                                                                <Label fx:id="lblEstoqueInicial" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="0 un." />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Seção 2: Dados Principais e Valores -->
                                        <GridPane hgap="16.0" vgap="12.0">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50.0" />
                                                <ColumnConstraints percentWidth="50.0" />
                                            </columnConstraints>

                                            <children>
                                                <!-- Linha 0: Nome e Código Loja -->
                                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                            <children>
                                                                <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Nome do Produto:" />
                                                                <Region HBox.hgrow="ALWAYS" />
                                                                <Button fx:id="btnBuscarWebNome" onAction="#handleBuscarNaWeb"
                                                                        style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-font-weight: bold; -fx-font-size: 10px; -fx-background-radius: 4px; -fx-cursor: hand;"
                                                                        text="Buscar na Internet" />
                                                            </children>
                                                        </HBox>
                                                        <TextField fx:id="txtNome" promptText="Ex: spray da marca etaniz, mouse logitech..."
                                                                   styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <children>
                                                        <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Código da Loja (SKU):" />
                                                        <TextField fx:id="txtCodigoLoja" styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <!-- Linha 1: Grupo / Fabricante e Localização -->
                                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <children>
                                                        <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Grupo / Fabricante:" />
                                                        <TextField fx:id="txtGrupo" promptText="Ex: 09 SPRAY, 27 NAUTICA, 10 WANDA"
                                                                   styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                            <children>
                                                                <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Localização no Depósito:" />
                                                                <Region HBox.hgrow="ALWAYS" />
                                                                <Button fx:id="btnVerLocalMapa" onAction="#handleVerLocalMapa"
                                                                        style="-fx-background-color: #FEF3C7; -fx-text-fill: #92400E; -fx-font-weight: bold; -fx-font-size: 10px; -fx-background-radius: 4px; -fx-cursor: hand;"
                                                                        text="Ver no Mapa" />
                                                            </children>
                                                        </HBox>
                                                        <TextField fx:id="txtLocalizacao" promptText="Ex: Estante A1, Prateleira B3"
                                                                   styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <!-- Linha 2: Valor à Vista e Valor a Prazo -->
                                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                    <children>
                                                        <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Valor à Vista (R$):" />
                                                        <TextField fx:id="txtPrecoVista" styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <children>
                                                        <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="Valor a Prazo (R$):" />
                                                        <TextField fx:id="txtPrecoPrazo" styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>

                                                <!-- Linha 3: URL / Caminho da Imagem -->
                                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                                                    <children>
                                                        <Label style="-fx-font-weight: 600; -fx-font-size: 12px;" text="URL / Caminho da Imagem:" />
                                                        <TextField fx:id="txtUrlImagem" promptText="https://... ou file:///..."
                                                                   styleClass="search-field" prefWidth="Infinity" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>

                                        <!-- Seção 3: Foto e Descrição do Produto -->
                                        <VBox spacing="10.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 14px 0 0 0;">
                                            <children>
                                                <HBox spacing="16.0">
                                                    <children>
                                                        <VBox alignment="CENTER" styleClass="ai-placeholder-card" prefWidth="230.0" minHeight="170.0" spacing="8.0">
                                                            <children>
                                                                <ImageView fx:id="imgProduto" fitHeight="110.0" fitWidth="170.0"
                                                                           pickOnBounds="true" preserveRatio="true" />
                                                                <Label fx:id="lblFotoPlaceholder" style="-fx-font-size: 11px; -fx-text-fill: #64748B; -fx-text-alignment: CENTER;"
                                                                       wrapText="true" text="Nenhuma foto carregada&#10;Clique em 'Buscar na Internet' acima" />

                                                                <HBox fx:id="boxImageNav" alignment="CENTER" spacing="8.0" visible="false" managed="false">
                                                                    <children>
                                                                        <Button onAction="#handleFotoAnterior"
                                                                                style="-fx-background-color: #E2E8F0; -fx-font-size: 10px; -fx-padding: 2px 8px; -fx-cursor: hand;" text="&lt;" />
                                                                        <Label fx:id="lblFotoCounter" style="-fx-font-size: 10px; -fx-text-fill: #475569;" text="1 / 1" />
                                                                        <Button onAction="#handleFotoProxima"
                                                                                style="-fx-background-color: #E2E8F0; -fx-font-size: 10px; -fx-padding: 2px 8px; -fx-cursor: hand;" text="&gt;" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label style="-fx-font-weight: 600; -fx-font-size: 12px;"
                                                                       text="Descrição do Produto:" />
                                                                <TextArea fx:id="txtDescricaoBreve" prefRowCount="6"
                                                                          promptText="Descrição detalhada e comercial do produto..."
                                                                          wrapText="true" styleClass="search-field" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ABA 2: Histórico de Movimentações & Calendário -->
                <Tab text="Histórico de Movimentações &amp; Calendário">
                    <content>
                        <VBox spacing="14.0" style="-fx-padding: 20px 24px; -fx-background-color: #FFFFFF;">
                            <children>
                                <!-- Barra Superior de Filtro por Calendário (Dia / Mês / Ano) -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px 16px;">
                                    <children>
                                        <Label text="Filtrar por Data (Dia/Mês/Ano):"
                                               style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                        <DatePicker fx:id="dpFiltroData" promptText="Selecione uma data..."
                                                    prefWidth="160.0" styleClass="search-field" />
                                        <Button onAction="#handleFiltrarData" text="Filtrar"
                                                styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 12px;" />
                                        <Button onAction="#handleFiltrarHoje" text="Hoje"
                                                styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 12px;" />
                                        <Button onAction="#handleLimparFiltroData" text="Todos os Registros"
                                                style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-cursor: hand;" />

                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblFiltroHistoricoStatus" text="Exibindo: Todos os Registros"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" />
                                    </children>
                                </HBox>

                                <!-- Cards de Métricas e Totais de Entradas/Saídas -->
                                <HBox spacing="14.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="TOTAL ADICIONADO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #15803D;" />
                                                        <Label fx:id="lblTotalAdicionado" text="+0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-red" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="TOTAL SUBTRAÍDO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;" />
                                                        <Label fx:id="lblTotalSubtraido" text="-0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #991B1B;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="metric-card-blue" HBox.hgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="SALDO ATUAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;" />
                                                        <Label fx:id="lblSaldoAtualHistorico" text="0 un." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Tabela de Extrato de Movimentações -->
                                <TableView fx:id="tblHistorico" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colDataHora" text="Data e Hora (Dia/Mês/Ano)" prefWidth="150.0" />
                                        <TableColumn fx:id="colTipo" text="Operação" prefWidth="90.0" />
                                        <TableColumn fx:id="colQtdAlterada" text="Movimento" prefWidth="90.0" />
                                        <TableColumn fx:id="colSaldo" text="Saldo (De -> Para)" prefWidth="120.0" />
                                        <TableColumn fx:id="colResponsavel" text="Responsável" prefWidth="120.0" />
                                        <TableColumn fx:id="colMotivo" text="Motivo / Origem" prefWidth="180.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="Nenhuma movimentação registrada para os critérios selecionados."
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <!-- Botões de Ação do Rodapé -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0"
              style="-fx-padding: 14px 24px; -fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
            <children>
                <Button onAction="#handleExcluirProduto"
                        style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;"
                        text="Excluir Produto" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleFechar" styleClass="btn-secondary" text="Cancelar / Fechar" />
                <Button onAction="#handleSalvarAlteracoes" styleClass="btn-primary" text="Salvar Alterações" />
            </children>
        </HBox>
    </children>
</VBox>
