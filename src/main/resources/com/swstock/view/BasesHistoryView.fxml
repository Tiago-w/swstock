<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="750.0" prefWidth="1180.0"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.BasesHistoryController">

    <children>
        <!-- Topo: Banner Superior -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-banner">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="SWStock" />
                        <Label text="Histórico Geral (Bases Automotivas &amp; Prediais)"
                               style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnResponsavelSessao" onAction="#handleTrocarResponsavel"
                        styleClass="badge-responsavel" text="👤 Responsável: Administrador" />
                <Button onAction="#handleExportarPdf" styleClass="btn-primary" text="Exportar Relatório PDF" style="-fx-font-size: 11px; -fx-padding: 6px 14px;" />
                <Button onAction="#handleFechar" styleClass="btn-secondary" text="Fechar" />
            </children>
        </HBox>

        <!-- Conteúdo Principal -->
        <VBox spacing="14.0" VBox.vgrow="ALWAYS" style="-fx-padding: 18px 24px;">
            <children>
                <!-- Barra de Filtros e Calendário -->
                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 14px 18px;">
                    <children>
                        <!-- Linha 1: Período e Atalhos -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Período:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />

                                <Label text="De:" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                                <DatePicker fx:id="dpDataInicio" promptText="Data inicial" prefWidth="135.0" styleClass="search-field" />

                                <Label text="Até:" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                                <DatePicker fx:id="dpDataFim" promptText="Data final" prefWidth="135.0" styleClass="search-field" />

                                <Button onAction="#handleFiltrar" text="Filtrar" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-padding: 6px 14px;" />

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;" />

                                <Button onAction="#handleAtalhoHoje" text="Hoje" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoUltimos7Dias" text="Últimos 7 Dias" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoEsteMes" text="Este Mês" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;" />
                                <Button onAction="#handleAtalhoTodos" text="Todo o Período"
                                        style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Separator style="-fx-opacity: 0.2;" />

                        <!-- Linha 2: Tipo de Base, Operação e Busca -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Tipo de Base:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <ComboBox fx:id="cbTipoBase" prefWidth="190.0" styleClass="search-field" />

                                <Label text="Operação:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <ComboBox fx:id="cbTipoOperacao" prefWidth="170.0" styleClass="search-field" />

                                <Label text="Buscar:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <TextField fx:id="txtBusca" promptText="Buscar por tamanho, nome, motivo ou responsável..."
                                           styleClass="search-field" prefWidth="250.0" HBox.hgrow="ALWAYS" />

                                <Button onAction="#handleLimparFiltros" text="Limpar Filtros" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 12px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Cards de Métricas e Totais -->
                <HBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="TOTAL DE ENTRADAS (BASES)" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #15803D;" />
                                        <Label fx:id="lblTotalEntradas" text="+0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-red" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="TOTAL DE SAÍDAS (BASES)" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;" />
                                        <Label fx:id="lblTotalSaidas" text="-0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #991B1B;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-card-blue" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="BALANÇO LÍQUIDO DO PERÍODO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;" />
                                        <Label fx:id="lblBalanco" text="0 un." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 14px;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="REGISTROS ENCONTRADOS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                        <Label fx:id="lblTotalRegistros" text="0 movimentos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Tabela de Movimentações das Bases -->
                <TableView fx:id="tblHistoricoBases" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDataHora" id="colDataHora" text="Data e Hora" prefWidth="145.0" styleClass="col-left" />
                        <TableColumn fx:id="colCodigo" id="colCodigo" text="Tamanho da Base" prefWidth="120.0" styleClass="col-left" />
                        <TableColumn fx:id="colNome" id="colNome" text="Nome da Base" prefWidth="220.0" styleClass="col-left" />
                        <TableColumn fx:id="colTipoBase" id="colTipoBase" text="Tipo de Base" prefWidth="120.0" styleClass="col-center" />
                        <TableColumn fx:id="colTipoOperacao" id="colTipoOperacao" text="Operação" prefWidth="100.0" styleClass="col-center" />
                        <TableColumn fx:id="colMovimento" id="colMovimento" text="Movimento" prefWidth="95.0" styleClass="col-center" />
                        <TableColumn fx:id="colSaldo" id="colSaldo" text="Saldo (De -> Para)" prefWidth="125.0" styleClass="col-center" />
                        <TableColumn fx:id="colResponsavel" id="colResponsavel" text="Responsável" prefWidth="120.0" styleClass="col-left" />
                        <TableColumn fx:id="colMotivo" id="colMotivo" text="Motivo / Origem" prefWidth="180.0" styleClass="col-left" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;"
                               text="Nenhuma movimentação de base encontrada para os filtros selecionados." />
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
