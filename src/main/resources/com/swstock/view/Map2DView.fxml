<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="1100.0"
            stylesheets="@../css/styles.css"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.swstock.controller.Map2DController">

    <!-- Topo: Cabeçalho com Título e Status de Destaque -->
    <top>
        <VBox spacing="8.0" style="-fx-background-color: #0F172A; -fx-padding: 16px 24px;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                                               text="Planta Baixa do Depósito térreo" />
                                        <Label style="-fx-background-color: #1E293B; -fx-text-fill: #60A5FA; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3px 8px; -fx-background-radius: 4px;"
                                               text="INTERATIVO 2D" />
                                    </children>
                                </HBox>
                                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"
                                       text="Passe o cursor sobre qualquer estante para inspecionar e clique para listar os produtos alocados nela." />
                            </children>
                        </VBox>

                        <!-- Banner de Destaque quando aberto a partir de um produto específico -->
                        <HBox fx:id="boxDestaqueAlvo" alignment="CENTER" spacing="8.0"
                              style="-fx-background-color: rgba(220, 38, 38, 0.2); -fx-border-color: #EF4444; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 14px;"
                              visible="false" managed="false">
                            <children>
                                <Label style="-fx-text-fill: #FCA5A5; -fx-font-size: 14px;" text="" />
                                <Label fx:id="lblDestaqueAlvo"
                                       style="-fx-text-fill: #FEE2E2; -fx-font-weight: bold; -fx-font-size: 12px;"
                                       text="Localização do Produto: ESTANTE A1 (Piscando)" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- Centro: SplitPane com Planta Baixa à Esquerda e Painel de Produtos à Direita -->
    <center>
        <SplitPane dividerPositions="0.67" style="-fx-background-color: transparent;">
            <items>

                <!-- Lado Esquerdo: Desenho da Planta Baixa do Armazém -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: #0F172A; -fx-padding: 16px;">
                    <content>
                        <VBox spacing="18.0" style="-fx-background-color: #1E293B; -fx-background-radius: 12px; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-padding: 20px;">
                            <children>


                                <!-- Bloco de Corredores A, B, C, D e Dinâmicos -->
                                <VBox spacing="14.0">
                                    <children>
                                        <!-- Corredor A -->
                                        <VBox spacing="8.0" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #60A5FA;"
                                                               text=" BLOCO A • Acessórios &amp; Peças" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Corredor 01" />
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="paneCorredorA" hgap="12.0" vgap="12.0" />
                                            </children>
                                        </VBox>

                                        <!-- Corredor B -->
                                        <VBox spacing="8.0" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #34D399;"
                                                               text=" BLOCO B • Eletrônicos &amp; Periféricos" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Corredor 02" />
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="paneCorredorB" hgap="12.0" vgap="12.0" />
                                            </children>
                                        </VBox>

                                        <!-- Corredor C -->
                                        <VBox spacing="8.0" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FBBF24;"
                                                               text=" BLOCO C • Ferramentas &amp; Insumos" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Corredor 03" />
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="paneCorredorC" hgap="12.0" vgap="12.0" />
                                            </children>
                                        </VBox>

                                        <!-- Corredor D -->
                                        <VBox spacing="8.0" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #F472B6;"
                                                               text=" BLOCO D • Tintas, Químicos &amp; Embalagens" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Corredor 04" />
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="paneCorredorD" hgap="12.0" vgap="12.0" />
                                            </children>
                                        </VBox>

                                        <!-- Outras Localizações Dinâmicas do Banco -->
                                        <VBox fx:id="boxOutrasLocalizacoes" spacing="8.0"
                                              style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #A78BFA;"
                                                               text=" Outras Áreas &amp; Paletes Cadastrados" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Setor Flexível" />
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="paneOutrasLocalizacoes" hgap="12.0" vgap="12.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Lado Direito: Painel de Produtos da Estante Selecionada -->
                <VBox spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-padding: 18px;">
                    <children>
                        <!-- Cabeçalho da Estante Selecionada -->
                        <VBox spacing="4.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 12px 0;">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" text="ESTANTE SELECIONADA" />
                                <Label fx:id="lblEstanteTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"
                                       text="Clique em uma estante" />
                                <Label fx:id="lblEstanteResumo" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                                       text="Selecione uma prateleira no mapa para ver seus produtos." />
                            </children>
                        </VBox>

                        <!-- Tabela de Produtos da Estante -->
                        <TableView fx:id="tblProdutosEstante" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colEstanteNome" prefWidth="170.0" text="PRODUTO" />
                                <TableColumn fx:id="colEstanteQtd" prefWidth="70.0" text="QTD" />
                                <TableColumn fx:id="colEstantePreco" prefWidth="80.0" text="VALOR" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"
                                       text="Nenhum produto cadastrado nesta estante." />
                            </placeholder>
                        </TableView>

                        <!-- Ações Rápidas do Painel -->
                        <VBox spacing="8.0">
                            <children>
                                <Button fx:id="btnFiltrarPrincipal" maxWidth="Infinity" onAction="#handleFiltrarTabelaPrincipal"
                                        styleClass="btn-primary" text=" Filtrar na Tela Principal" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </items>
        </SplitPane>
    </center>

    <!-- Rodapé: Legenda e Controles -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="16.0" style="-fx-padding: 12px 24px; -fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" text="Legenda:" />
                        <HBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Circle fill="#16A34A" radius="5.0" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #334155;" text="Com Estoque" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Circle fill="#64748B" radius="5.0" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #334155;" text="Vazia / Livre" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Circle fill="#2563EB" radius="5.0" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #334155;" text="Selecionada" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Circle fill="#EF4444" radius="5.0" />
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"
                                       text=" Local do Produto (Piscando)" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Button onAction="#handleExibirTodos" styleClass="btn-secondary" text="Mostrar Todo o Estoque" />
                <Button onAction="#handleFechar" styleClass="btn-primary" text="Fechar Mapa" />
            </children>
        </HBox>
    </bottom>

</BorderPane>

