<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.swstock.controller.MainController">

    <!-- Topo: Banner Superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="header-banner">
            <children>
                <Button fx:id="btnToggleSidebar" onAction="#handleToggleSidebar"
                        styleClass="hamburger-button" text="☰" />
                <ImageView fx:id="imgLogoEmpresa" fitHeight="38.0" preserveRatio="true" smooth="true"
                           visible="false" managed="false" />
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="SWStock" />
                        <Label fx:id="lblHeaderStats" text="Carregando estoque..."
                               style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnResponsavelSessao" onAction="#handleTrocarResponsavel"
                        styleClass="badge-responsavel" text="👤 Responsável: Administrador" />
            </children>
        </HBox>
    </top>

    <!-- Lateral Esquerda: Sidebar Retrátil -->
    <left>
        <VBox fx:id="sidebar" spacing="8.0" styleClass="sidebar" visible="false" managed="false">
            <children>
                <Label styleClass="sidebar-heading" text="MENU" />

                <Button fx:id="btnHistoricoGeral" maxWidth="Infinity" onAction="#handleAbrirHistoricoGeral"
                        styleClass="nav-button" text="Histórico Geral" />

                <Button fx:id="btnHistoricoGeralBases" maxWidth="Infinity" onAction="#handleAbrirHistoricoGeralBases"
                        styleClass="nav-button" text="Histórico Geral das Bases" />

                <Button fx:id="btnLevantamentoEstoque" maxWidth="Infinity" onAction="#handleAbrirLevantamentoEstoque"
                        styleClass="nav-button" text="Levantamento de Estoque" />

                <Button fx:id="btnLevantamentoBases" maxWidth="Infinity" onAction="#handleAbrirLevantamentoBases"
                        styleClass="nav-button" text="Levantamento de Bases" />

                <Button fx:id="btnFuncionarios" maxWidth="Infinity" onAction="#handleAbrirFuncionarios"
                        styleClass="nav-button" text="Vendedores" />

                <Button fx:id="btnImportarXml" maxWidth="Infinity" onAction="#handleImportarXml"
                        styleClass="nav-button" text="Importar Estoque XML" />

                <Button fx:id="btnExportarXml" maxWidth="Infinity" onAction="#handleExportarXml"
                        styleClass="nav-button" text="Exportar Estoque XML" />

                <Button fx:id="btnConfiguracoes" maxWidth="Infinity" onAction="#handleAbrirConfiguracoes"
                        styleClass="nav-button" text="Gestão do Sistema" />

                <Button fx:id="btnAlterarLogo" maxWidth="Infinity" onAction="#handleAlterarLogo"
                        styleClass="nav-button" text="Alterar/adicionar logo" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator style="-fx-opacity: 0.2;" />

                <Button fx:id="btnSair" maxWidth="Infinity" onAction="#handleSair"
                        styleClass="nav-button-danger" text="  Encerrar &amp; Fechar DB" />
            </children>
        </VBox>
    </left>

    <!-- Centro: Área Principal e Tabela -->
    <center>
        <VBox spacing="14.0" styleClass="main-container">
            <children>
                <!-- Cards KPI Clicáveis (Filtros Rápidos de Estoque) -->
                <HBox styleClass="kpi-row">
                    <children>
                        <!-- Card 1: Hero Azul SWStock -->
                        <VBox fx:id="kpiCardTotal" onMouseClicked="#handleKpiFiltroTodos"
                              spacing="5.0" HBox.hgrow="ALWAYS" styleClass="kpi-card-hero">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="TOTAL EM ESTOQUE" styleClass="kpi-hero-label" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <StackPane styleClass="kpi-icon-hero">
                                            <Group>
                                                <SVGPath content="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"
                                                         fill="#FFFFFF" scaleX="0.65" scaleY="0.65" />
                                            </Group>
                                        </StackPane>
                                    </children>
                                </HBox>
                                <Label fx:id="lblKpiTotalUnidades" text="0 un." styleClass="kpi-hero-value" />
                                <Label fx:id="lblKpiTotalProdutos" text="0 produtos cadastrados" styleClass="kpi-hero-sub" />
                            </children>
                        </VBox>

                        <!-- Card 2: Disponíveis -->
                        <VBox fx:id="kpiCardDisponivel" onMouseClicked="#handleKpiFiltroDisponivel"
                              spacing="5.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="DISPONÍVEIS" styleClass="kpi-label" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <StackPane styleClass="kpi-icon-ok">
                                            <Group>
                                                <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                         fill="#15803D" scaleX="0.70" scaleY="0.70" />
                                            </Group>
                                        </StackPane>
                                    </children>
                                </HBox>
                                <Label fx:id="lblKpiDisponiveis" text="0 itens" styleClass="kpi-value" />
                                <Label text="Estoque regular (&gt; 5 un.)" styleClass="kpi-sub-ok" />
                            </children>
                        </VBox>

                        <!-- Card 3: Estoque Baixo -->
                        <VBox fx:id="kpiCardBaixo" onMouseClicked="#handleKpiFiltroBaixo"
                              spacing="5.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="ESTOQUE BAIXO" styleClass="kpi-label" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <StackPane styleClass="kpi-icon-low">
                                            <Group>
                                                <SVGPath content="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                                         fill="#B45309" scaleX="0.65" scaleY="0.65" />
                                            </Group>
                                        </StackPane>
                                    </children>
                                </HBox>
                                <Label fx:id="lblKpiBaixo" text="0 itens" styleClass="kpi-value" />
                                <Label text="Atenção (1 a 5 un.)" styleClass="kpi-sub-low" />
                            </children>
                        </VBox>

                        <!-- Card 4: Sem Estoque -->
                        <VBox fx:id="kpiCardZerado" onMouseClicked="#handleKpiFiltroZerado"
                              spacing="5.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="SEM ESTOQUE" styleClass="kpi-label" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <StackPane styleClass="kpi-icon-empty">
                                            <Group>
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11H7v-2h10v2z"
                                                         fill="#B91C1C" scaleX="0.68" scaleY="0.68" />
                                            </Group>
                                        </StackPane>
                                    </children>
                                </HBox>
                                <Label fx:id="lblKpiZerado" text="0 itens" styleClass="kpi-value" />
                                <Label text="Itens zerados (0 un.)" styleClass="kpi-sub-empty" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Barra de Ações Rápidas -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="action-bar">
                    <children>
                        <TextField fx:id="txtSearch" promptText=" Buscar por nome, código, grupo ou descrição..."
                                   styleClass="search-field" HBox.hgrow="NEVER" />

                        <Button fx:id="btnNovoProduto" onAction="#handleNovoProduto"
                                styleClass="btn-primary" text="+ Novo Produto" />

                        <Button fx:id="btnRecarregar" onAction="#handleRecarregar"
                                styleClass="btn-secondary" text=" Atualizar" />

                        <Button fx:id="btnBasesAutomotivas" onAction="#handleAbrirBasesAutomotivas"
                                styleClass="btn-secondary" text="Bases" />
                        

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label fx:id="lblFiltroAtivo" styleClass="badge-location"
                                       text="Exibindo: Todos os itens" />
                                <Button fx:id="btnLimparFiltro" onAction="#handleLimparFiltro"
                                        styleClass="btn-secondary" text=" Limpar Filtro"
                                        visible="false" managed="false" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Tabela Principal de Produtos -->
                <TableView fx:id="tblProdutos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigoLoja" id="colCodigoLoja" minWidth="80.0" prefWidth="105.0" text="CÓD. LOJA" styleClass="col-left" />
                        <TableColumn fx:id="colNome" id="colNome" minWidth="180.0" prefWidth="300.0" text="NOME DO PRODUTO" styleClass="col-left" />
                        <TableColumn fx:id="colGrupo" id="colGrupo" minWidth="110.0" prefWidth="160.0" text="GRUPO / FABRICANTE" styleClass="col-left" />
                        <TableColumn fx:id="colPrecoVista" id="colPrecoVista" minWidth="95.0" prefWidth="125.0" text="VALOR À VISTA" styleClass="col-right" />
                        <TableColumn fx:id="colPrecoPrazo" id="colPrecoPrazo" minWidth="95.0" prefWidth="125.0" text="VALOR A PRAZO" styleClass="col-right" />
                        <TableColumn fx:id="colLocalizacao" id="colLocalizacao" minWidth="110.0" prefWidth="135.0" text="LOCALIZAÇÃO" styleClass="col-left" />
                        <TableColumn fx:id="colQuantidade" id="colQuantidade" minWidth="90.0" prefWidth="115.0" text="QUANTIDADE" styleClass="col-center" />
                        <TableColumn fx:id="colAcoes" id="colAcoes" minWidth="120.0" prefWidth="135.0" text="AÇÕES" sortable="false" styleClass="col-center" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;"
                               text="Nenhum produto cadastrado ou correspondente ao filtro." />
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Rodapé: Barra de Status -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-bar">
            <children>
                <Circle fill="#16A34A" radius="5.0" />
                <Label fx:id="lblStatus" styleClass="status-text"
                       text="Banco de Dados SQLite: Conectado e Operacional (Offline)" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotalItens" styleClass="status-text"
                       text="Total: 0 produtos cadastrados" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
