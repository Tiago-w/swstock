<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.swstock.controller.MainController">

    <!-- Topo: Banner Superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-banner">
            <children>
                <Button fx:id="btnToggleSidebar" onAction="#handleToggleSidebar"
                        styleClass="hamburger-button" text="☰" />
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="SWStock" />
                        <Label fx:id="lblHeaderStats" text="Carregando estoque..."
                               style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- Lateral Esquerda: Sidebar Retrátil -->
    <left>
        <VBox fx:id="sidebar" spacing="8.0" styleClass="sidebar" visible="false" managed="false">
            <children>
                <Label styleClass="sidebar-heading" text="MENU" />

                <Button fx:id="btnMapa2D" maxWidth="Infinity" onAction="#handleAbrirMapa2D"
                        styleClass="nav-button" text="Mapa do Depósito: Térreo" />

                <Button fx:id="btnMapa2D" maxWidth="Infinity" onAction="#handleAbrirMapa2D"
                        styleClass="nav-button" text="Mapa do Depósito: 1º Andar" />

                <Button fx:id="btnHistoricoGeral" maxWidth="Infinity" onAction="#handleAbrirHistoricoGeral"
                        styleClass="nav-button" text="Calendário &amp; Histórico Geral" />

                <Button fx:id="btnImportarXml" maxWidth="Infinity" onAction="#handleImportarXml"
                        styleClass="nav-button" text="Importar Estoque XML" />

                <Button fx:id="btnExportarXml" maxWidth="Infinity" onAction="#handleExportarXml"
                        styleClass="nav-button" text="Exportar Estoque XML" />

                <Button fx:id="btnFuncionarios" maxWidth="Infinity" onAction="#handleAbrirFuncionarios"
                        styleClass="nav-button" text="Funcionários" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator style="-fx-opacity: 0.2;" />

                <Button fx:id="btnSair" maxWidth="Infinity" onAction="#handleSair"
                        styleClass="nav-button-danger" text="🚪  Encerrar &amp; Fechar DB" />
            </children>
        </VBox>
    </left>

    <!-- Centro: Área Principal e Tabela -->
    <center>
        <VBox spacing="14.0" styleClass="main-container">
            <children>
                <!-- Barra de Ações Rápidas -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="action-bar">
                    <children>
                        <TextField fx:id="txtSearch" promptText="🔍 Buscar por nome, código, grupo ou descrição..."
                                   styleClass="search-field" HBox.hgrow="NEVER" />

                        <Button fx:id="btnNovoProduto" onAction="#handleNovoProduto"
                                styleClass="btn-primary" text="+ Novo Produto" />

                        <Button fx:id="btnRecarregar" onAction="#handleRecarregar"
                                styleClass="btn-secondary" text="🔄 Atualizar" />

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label fx:id="lblFiltroAtivo" styleClass="badge-location"
                                       text="Exibindo: Todos os itens" />
                                <Button fx:id="btnLimparFiltro" onAction="#handleLimparFiltro"
                                        styleClass="btn-secondary" text="✕ Limpar Filtro"
                                        visible="false" managed="false" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Tabela Principal de Produtos -->
                <TableView fx:id="tblProdutos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigoLoja" minWidth="80.0" prefWidth="95.0" text="CÓD. LOJA" styleClass="col-left" />
                        <TableColumn fx:id="colNome" minWidth="180.0" prefWidth="230.0" text="NOME DO PRODUTO" styleClass="col-left" />
                        <TableColumn fx:id="colGrupo" minWidth="110.0" prefWidth="135.0" text="GRUPO / FABRICANTE" styleClass="col-left" />
                        <TableColumn fx:id="colPrecoVista" minWidth="95.0" prefWidth="115.0" text="VALOR À VISTA" styleClass="col-right" />
                        <TableColumn fx:id="colPrecoPrazo" minWidth="95.0" prefWidth="115.0" text="VALOR A PRAZO" styleClass="col-right" />
                        <TableColumn fx:id="colLocalizacao" minWidth="110.0" prefWidth="125.0" text="LOCALIZAÇÃO" styleClass="col-left" />
                        <TableColumn fx:id="colQuantidade" minWidth="90.0" prefWidth="105.0" text="QUANTIDADE" styleClass="col-center" />
                        <TableColumn fx:id="colAcoes" minWidth="120.0" prefWidth="130.0" text="AÇÕES" sortable="false" styleClass="col-center" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;"
                               text="Nenhum produto cadastrado ou correspondente ao filtro." />
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Rodapé: Barra de Status -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-bar">
            <children>
                <Circle fill="#16A34A" radius="5.0" />
                <Label fx:id="lblStatus" styleClass="status-text"
                       text="Banco de Dados SQLite: Conectado e Operacional (Offline)" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotalItens" styleClass="status-text"
                       text="Total: 0 produtos cadastrados" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
