<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="640.0" spacing="0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.swstock.controller.FuncionariosController">
    <children>
        <!-- Topo da Janela -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0F172A; -fx-padding: 16px 20px;">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="Gestão de Funcionários" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Cadastre ou remova os responsáveis pelas alterações e saídas de estoque" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleFechar" style="-fx-background-color: #334155; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 6px 12px;" text="Fechar" />
            </children>
        </HBox>

        <!-- Formulário de Cadastro Rápido -->
        <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16px 20px; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Cadastrar Novo Funcionário / Responsável:" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <TextField fx:id="txtNovoNome" promptText="Digite o nome do funcionário (ex: Roberto)" style="-fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAdicionar" defaultButton="true" onAction="#handleAdicionar" style="-fx-background-color: #1565C0; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8px 18px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Adicionar" />
                    </children>
                </HBox>
                <Label fx:id="lblFeedback" text="" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false" managed="false" />
            </children>
        </VBox>

        <!-- Tabela de Funcionários Cadastrados -->
        <VBox spacing="8.0" style="-fx-padding: 16px 20px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Funcionários Ativos no Sistema" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalFuncionarios" style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="0 cadastrados" />
                    </children>
                </HBox>

                <TableView fx:id="tblFuncionarios" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="#" />
                        <TableColumn fx:id="colNome" prefWidth="300.0" text="Nome do Funcionário" />
                        <TableColumn fx:id="colDataCriacao" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Cadastrado em" />
                        <TableColumn fx:id="colAcoes" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Ações" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
