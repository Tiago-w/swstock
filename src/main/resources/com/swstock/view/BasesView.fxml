<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="700.0" prefWidth="1100.0"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.swstock.controller.BasesController">

    <children>
        <!-- Topo: Banner Superior -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="header-banner">
            <children>
                <ImageView fx:id="imgLogoEmpresa" fitHeight="38.0" preserveRatio="true" smooth="true"
                           visible="false" managed="false" />
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="SWStock" />
                        <Label fx:id="lblHeaderSubtitulo" text="Gestão de Bases de Tintas: Automotivas e Prediais"
                               style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnResponsavelSessao" onAction="#handleTrocarResponsavel"
                        styleClass="badge-responsavel" text="👤 Responsável: Administrador" />
                <Button onAction="#handleAbrirHistoricoBases" graphicTextGap="7.0"
                        styleClass="btn-header-accent" text="Histórico Geral de Bases">
                    <graphic>
                        <Group>
                            <SVGPath content="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                     fill="#FFFFFF" scaleX="0.64" scaleY="0.64" />
                        </Group>
                    </graphic>
                </Button>
                <Button onAction="#handleFechar" styleClass="btn-secondary" text="Fechar" />
            </children>
        </HBox>

        <!-- Conteúdo Principal -->
        <VBox spacing="14.0" VBox.vgrow="ALWAYS" style="-fx-padding: 18px 24px;">
            <children>
                <!-- Faixa Fixa de Alternância de Abas -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="bases-category-bar">
                    <children>
                        <Label text="Categoria de Bases:" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 13px;" />
                        <HBox spacing="4.0" styleClass="bases-segmented-track">
                            <children>
                                <Button fx:id="btnTabAutomotivas" onAction="#handleSelecionarAutomotivas"
                                        text="Bases Automotivas" prefWidth="180.0"
                                        styleClass="bases-seg-btn-active-auto" />
                                <Button fx:id="btnTabPrediais" onAction="#handleSelecionarPrediais"
                                        text="Bases Prediais" prefWidth="180.0"
                                        styleClass="bases-seg-btn-inactive" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Dica: dê dois cliques em uma base para modificar" styleClass="bases-hint-label" />
                        <Label fx:id="lblTotalBasesExibidas" styleClass="badge-location" text="0 bases cadastradas" />
                    </children>
                </HBox>

                <!-- Barra de Ações e Filtros de Busca -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="action-bar">
                    <children>
                        <TextField fx:id="txtBusca" promptText="Buscar por tamanho, nome ou fabricante..."
                                   styleClass="search-field" prefWidth="320.0" HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="cbFabricanteFiltro" prefWidth="190.0" promptText="Fabricante"
                                  styleClass="search-field" />

                        <Button onAction="#handleNovaBase" styleClass="btn-primary" text="+ Nova Base" />

                        <Button onAction="#handleRecarregar" styleClass="btn-secondary" text="Atualizar" />
                    </children>
                </HBox>

                <!-- Tabela de Bases -->
                <TableView fx:id="tblBases" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTamanho" id="colTamanho" minWidth="90.0" prefWidth="110.0" text="TAMANHO" styleClass="col-left" />
                        <TableColumn fx:id="colNome" id="colNome" minWidth="220.0" prefWidth="300.0" text="NOME DA BASE" styleClass="col-left" />
                        <TableColumn fx:id="colTipo" id="colTipo" minWidth="110.0" prefWidth="130.0" text="TIPO" styleClass="col-center" />
                        <TableColumn fx:id="colFabricante" id="colFabricante" minWidth="110.0" prefWidth="140.0" text="FABRICANTE" styleClass="col-left" />
                        <TableColumn fx:id="colValorCompra" id="colValorCompra" minWidth="110.0" prefWidth="130.0" text="VALOR DE COMPRA" styleClass="col-right" />
                        <TableColumn fx:id="colQuantidade" id="colQuantidade" minWidth="100.0" prefWidth="120.0" text="QUANTIDADE" styleClass="col-center" />
                        <TableColumn fx:id="colAcoes" id="colAcoes" minWidth="160.0" prefWidth="180.0" text="AÇÕES" sortable="false" styleClass="col-center" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;"
                               text="Nenhuma base cadastrada para este tipo ou filtro." />
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
